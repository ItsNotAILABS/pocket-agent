{
  "schema": "nexus.capability.v1",
  "component": "pocket-agent",
  "repository": "ItsNotAILABS/pocket-agent",
  "role": "long-running-governed-execution-and-mission-plane",
  "research_corpus": "medina.corpus-architectura.v2@2.1.0",
  "actions": [
    "agent.run",
    "agent.attach",
    "agent.schedule",
    "agent.capsule",
    "agent.route_capability",
    "agent.evaluate_outcome",
    "agent.detect_drift",
    "agent.recovery_plan",
    "mission.create",
    "mission.list",
    "mission.inspect",
    "mission.run_burst",
    "mission.pause",
    "mission.resume",
    "mission.cancel",
    "mission.artifact.read",
    "mission.worker.run",
    "runtime_cell.create",
    "runtime_cell.inspect",
    "runtime_cell.operation.propose",
    "runtime_cell.operation.approve",
    "runtime_cell.operation.execute",
    "runtime_cell.receipts.verify"
  ],
  "produces": [
    "nexus.plan.v1",
    "nexus.job.v1",
    "nexus.execution-receipt.v1",
    "nexus.artifact.v1",
    "nexus.memory-event.v1",
    "nexus.handoff.v1",
    "nexus.runtime-cell.v1",
    "nexus.approval.v1",
    "nexus.audit-event.v1",
    "pocket.mission.snapshot.v1",
    "pocket.mission.task-result.v1",
    "pocket.mission.artifact-manifest.v1"
  ],
  "consumes": [
    "nexus.task.v1",
    "nexus.plan.v1",
    "nexus.policy-decision.v1",
    "nexus.approval.v1",
    "nexus.budget.v1",
    "nexus.context-pack.v1",
    "nexus.capability.v1",
    "nexus.runtime-cell.v1",
    "auro.2b-council.turn.v1"
  ],
  "mission_contract": {
    "state_store": "SQLite/WAL",
    "task_graph": "acyclic dependency DAG",
    "parallelism": "dependency-ready and mission-bounded",
    "recovery": "leased tasks with expiry and retry",
    "reasoning": "bounded decision summaries; private chain-of-thought is not exported",
    "artifacts": "path-safe, SHA-256 addressed, manifest and ZIP bundle",
    "multi_user": "tenant and principal bound",
    "execution": "runtime-cell tasks require exact one-time approval tokens"
  },
  "runtime_classes": ["agent-sandbox", "app-bottle", "mini-os"],
  "execution_sequence": ["discover", "classify-risk", "plan", "approve", "execute", "validate", "receipt"],
  "limits": {
    "tenant_identity_authority": false,
    "voice_turn_authority": false,
    "implicit_unbounded_autonomy": false,
    "private_reasoning_export": false,
    "nonempty_approval_id_is_authorization": false,
    "approval_reuse": false,
    "generated_code_receives_secrets_by_default": false,
    "generated_code_receives_network_by_default": false,
    "unsupported_binary_artifacts_are_faked": false,
    "mission_state_owned_by_model_runtime": false,
    "unattended_work_without_worker": false
  },
  "proof": {
    "state": "source",
    "tests_required_for_promotion": true,
    "runtime_cell_store": "src/pocket_agent/runtime_cells.py",
    "mission_store": "src/pocket_agent/mission_store.py",
    "mission_orchestrator": "src/pocket_agent/mission_orchestrator.py",
    "persistent_approval_replay_protection": true,
    "mission_lease_recovery": true,
    "artifact_hashing": true,
    "execution_backend_evidence_separate": true,
    "auro_reasoning_endpoint_evidence_separate": true
  },
  "authority": "ItsNotAILABS/nexus"
}
